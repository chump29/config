{
  "biome.configurationPath": "./biome.json",
  "biome.lsp.bin": "./node_modules/@biomejs/biome/bin/biome",
  "biome.suggestInstallingGlobally": false,
  "coverage-gutters.coverageFileNames": ["lcov.info"],
  "cSpell.blockCheckingWhenTextChunkSizeGreaterThan": 3000,
  "cSpell.import": ["${workspaceFolder}/.vscode/cspell.json"],
  "css.lint.unknownAtRules": "ignore",
  "editor.detectIndentation": true,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "git.autofetch": true,
  "js/ts.experimental.useTsgo": true,
  "js/ts.preferences.importModuleSpecifier": "relative",
  "pylint.cwd": "${workspaceFolder}/backend",
  "python.analysis.autoSearchPaths": false,
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.extraPaths": ["${workspaceFolder}/backend/features"],
  "python.analysis.include": ["${workspaceFolder}/backend/**/*.py"],
  "python.analysis.indexing": false,
  "python.analysis.typeCheckingMode": "standard",
  "python.analysis.useLibraryCodeForTypes": false,
  "python.envFile": "${workspaceFolder}/backend/.env",
  "python.terminal.activateEnvironment": false,
  "python.terminal.useEnvFile": true,
  "shellcheck.customArgs": ["-x"],
  "terminal.integrated.scrollback": 10000,
  "todo-tree.filtering.excludeGlobs": ["**/.vscode/settings.json", "**/TODO.md"],
  "todo-tree.general.tags": ["TODO"],
  "todo-tree.highlights.enabled": false,
  "todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|^[ \\t]*(-|\\d+.)).*($TAGS)",
  "todo-tree.ripgrep.ripgrep": "/usr/bin/rg",
  "[c][cpp][csharp][java]": {
    "editor.tabSize": 4
  },
  "[css][dockercompose][javascript][javascriptreact][json][jsonc][markdown][typescript][typescriptreact][yaml]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[csv]": {
    "editor.defaultFormatter": "csvlinter.csvlinter-vscode"
  },
  "[dockercompose]": {
    "editor.defaultFormatter": "SashaBusinaro.yaml-compose-sorter"
  },
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-containers"
  },
  "[github-actions-workflow][yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[markdown]": {
    "editor.defaultFormatter": "miccho27.m27-markdown-table-pro"
  },
  "[nginx]": {
    "editor.defaultFormatter": "ahmadalli.vscode-nginx-conf"
  },
  "[perl]": {
    "editor.defaultFormatter": "bscan.perlnavigator"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
    "editor.tabSize": 4
  },
  "[sh]": {
    "editor.defaultFormatter": "timonwong.shellcheck"
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.formatDocument": "explicit"
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "support.type.property-name.table",
        "settings": {
          "foreground": "#4ec9b0"
        }
      },
      {
        "scope": "support.type.property-name.array",
        "settings": {
          "foreground": "#569cd6"
        }
      },
      {
        "scope": "constant.other.time",
        "settings": {
          "foreground": "#dcdcaa"
        }
      },
      {
        "scope": "string.quoted",
        "settings": {
          "foreground": "#ce9178"
        }
      }
    ]
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/.venv/**": true,
    "**/coverage/**": true,
    "**/dist/**": true,
    "**/node_modules/**": true
  },
  "json.schemaDownload.trustedDomains": {
    "https://biomejs.dev/schemas/": true,
    "https://html-validate.org/schemas/": true
  },
  "pylint.args": [
    "--max-line-length=120",
    "--enable-all-extensions",
    "--disable=too-many-try-statements",
    "--disable=consider-using-assignment-expr"
  ],
  "pylint.severity": {
    "convention": "Error",
    "error": "Error",
    "fatal": "Error",
    "info": "Error",
    "refactor": "Error",
    "warning": "Error"
  }
}
