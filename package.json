{
  "name": "@postfmly/config",
  "version": "1.6.12",
  "description": "Configuration files",
  "keywords": [
    "config"
  ],
  "homepage": "https://github.com/chump29/config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/config.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "sideEffects": false,
  "type": "module",
  "bin": {
    "link-configs": "bin/link-configs"
  },
  "files": [
    "// ! NOTE: This makes e18e happy:",
    ".vscode/"
  ],
  "scripts": {
    "build": "bun run build:clean && bun run --bun bunup",
    "build:clean": "rm -rf dist",
    "lint": "bun run lint:spell && bun run lint:biome",
    "lint:biome": "bun run --bun biome check --write --verbose --error-on-warnings",
    "lint:spell": "bun run --bun cspell --dot .",
    "scan": "bun run scan:audit && bun run scan:cve && bun run scan:e18e",
    "scan:audit": "bun audit --prod",
    "scan:cve": "bunx --bun cve-lite-cli --check-overrides --check-network --check-maintenance --prod-only --only-used",
    "scan:e18e": "bunx --bun @e18e/cli analyze",
    "updates": "bunx --bun npm-check-updates --dep overrides,prod,dev --cooldown 0 --install never --packageManager bun --peer"
  },
  "overrides": {
    "chalk": "6.0.1",
    "undici-types": "8.12.3"
  },
  "dependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "cspell": "^10.4.0",
    "globals": "^17.13.0"
  },
  "devDependencies": {
    "bunup": "^0.16.32"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "^1.4.4"
  },
  "engineStrict": true
}
