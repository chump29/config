{
  "name": "@postfmly/config",
  "version": "1.4.31",
  "description": "Configuration files",
  "keywords": [
    "config"
  ],
  "homepage": "https://github.com/chump29/config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/config.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "type": "module",
  "bin": {
    "link-configs": "bin/link-configs"
  },
  "files": [
    ".vscode/",
    "biome.json",
    "bin/",
    "tsconfig.json"
  ],
  "scripts": {
    "check": "bun run check:deps && bun run check:outdated",
    "check:deps": "bunx --bun depcheck || :",
    "check:outdated": "bunx --bun npm-check-updates --install never --dep peer",
    "clean": "rm bun.lock",
    "lint": "bun run scan && bun run lint:spell && bun run lint:biome",
    "lint:biome": "bun run --bun biome check --write --verbose --error-on-warnings",
    "lint:spell": "bun run --bun cspell --dot --verbose .",
    "scan": "bun run --bun cve-lite"
  },
  "peerDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "cspell": "^10.0.1",
    "cve-lite-cli": "^1.26.0",
    "globals": "^17.7.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "~1.3.14"
  },
  "engineStrict": true
}
