{
  "name": "@postfmly/config",
  "version": "1.4.54",
  "description": "Configuration files",
  "keywords": [
    "config"
  ],
  "homepage": "https://github.com/chump29/config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/config.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "type": "module",
  "bin": {
    "link-configs": "bin/link-configs"
  },
  "files": [
    ".vscode/",
    "biome.json",
    "bin/",
    "tsconfig.json"
  ],
  "scripts": {
    "lint": "bun run scan && bun run lint:spell && bun run lint:biome",
    "lint:biome": "bun run --bun biome check --write --verbose --error-on-warnings",
    "lint:spell": "bun run --bun cspell --dot --verbose .",
    "scan": "bun audit && bun run --bun cve-lite",
    "updates": "bunx --bun npm-check-updates --dep peer --cooldown 0 --install never --packageManager bun --peer"
  },
  "peerDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "cspell": "^10.1.1",
    "cve-lite-cli": "^1.31.0",
    "globals": "^17.11.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "^1.4.0"
  },
  "engineStrict": true
}
