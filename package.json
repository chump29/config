{
  "name": "@postfmly/config",
  "version": "1.6.0",
  "description": "Configuration files",
  "keywords": [
    "config"
  ],
  "homepage": "https://github.com/chump29/config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/config.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "sideEffects": false,
  "type": "module",
  "bin": {
    "link-configs": "bin/link-configs"
  },
  "scripts": {
    "build": "bun run build:clean && bun run --bun bunup",
    "build:clean": "rm -rf dist",
    "lint": "bun run scan && bun run lint:spell && bun run lint:biome",
    "lint:biome": "bun run --bun biome check --write --verbose --error-on-warnings",
    "lint:spell": "bun run --bun cspell --dot --verbose .",
    "scan": "bun audit && bunx --bun cve-lite-cli --check-overrides",
    "scan:e18e": "bunx --bun @e18e/cli analyze",
    "updates": "bunx --bun npm-check-updates --dep overrides,prod --cooldown 0 --install never --packageManager bun --peer"
  },
  "overrides": {
    "chalk": "6.0.1",
    "ini": "7.0.0"
  },
  "dependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "cspell": "^10.3.6",
    "globals": "^17.13.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "bunup": "^0.16.32"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "^1.4.2"
  },
  "engineStrict": true
}
