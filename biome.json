{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "assist": {
    "actions": {
      "source": {
        "noDuplicateClasses": "on",
        "useSortedAttributes": "on",
        "useSortedEnumMembers": "on",
        "useSortedPackageJson": "on",
        "useSortedProperties": "on",
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":NODE:",
              ":BLANK_LINE:",
              ":BUN:",
              ":BLANK_LINE:",
              "react",
              ":BLANK_LINE:",
              "@tabler/icons-react",
              ":BLANK_LINE:",
              "@mantine/**",
              ":BLANK_LINE:",
              "@postfmly/**",
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              ":PATH:",
              ":BLANK_LINE:",
              ":STYLE:"
            ]
          }
        },
        "useSortedInterfaceMembers": {
          "level": "on",
          "options": {
            "partitionByNewLine": true
          }
        },
        "useSortedKeys": {
          "level": "on",
          "options": {
            "groupByNesting": true
          }
        }
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!.husky/prepare.*",
      "!!.pnpm-store",
      "!!.vscode",
      "!!**/*.html",
      "!!bun.lock",
      "!!coverage",
      "!!db/**/*",
      "db/schema.ts",
      "!!dist",
      "!!node_modules",
      "!!package.json",
      "!!tsconfig.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 120
  },
  "javascript": {
    "globals": ["Bun", "createMock"],
    "formatter": {
      "bracketSameLine": true,
      "semicolons": "asNeeded",
      "trailingCommas": "none"
    }
  },
  "linter": {
    "domains": {
      "drizzle": "all",
      "project": "all",
      "react": "all",
      "test": "all",
      "types": "all"
    },
    "rules": {
      "preset": "all",
      "complexity": {
        "noBannedTypes": "off",
        "noDivRegex": "error",
        "noExcessiveCognitiveComplexity": "off",
        "noExcessiveLinesPerFunction": "off",
        "noExcessiveNestedCallbacks": "error",
        "noExtraBooleanCast": "error",
        "noImplicitCoercions": "error",
        "noRedundantDefaultExport": "error",
        "noUnnecessaryTemplateExpression": "error",
        "noUselessCatch": "error",
        "noUselessReturn": "error",
        "noUselessUndefinedInitialization": "error",
        "useArrayFind": "error",
        "useLiteralKeys": "off",
        "useMathMinMax": "error",
        "useRegexpTest": "error"
      },
      "correctness": {
        "noComponentHookFactories": "error",
        "noJsxNamespace": "error",
        "noNodejsModules": "off",
        "noReactNativeRawText": "off",
        "noSolidDestructuredProps": "off",
        "noUndeclaredDependencies": "off",
        "noUndeclaredVariables": "error",
        "noUnresolvedImports": "off",
        "noUnusedInstantiation": "error",
        "useJsonImportAttributes": "error",
        "useQwikValidLexicalScope": "off",
        "useSingleJsDocAsterisk": "error"
      },
      "nursery": {
        "noAccidentalBitwiseOperators": "error",
        "noArrayForEach": "error",
        "noArrayMethodsOnArguments": "error",
        "noArraySortForMinMax": "error",
        "noAwaitInPromiseMethods": "error",
        "noBaseToString": "error",
        "noBooleanSortComparator": "error",
        "noChainedComparison": "error",
        "noConsoleSpaces": "error",
        "noConstantComparisons": "error",
        "noDanglingUnderscore": "error",
        "noDoubleComparison": "error",
        "noDynamicDelete": "error",
        "noEagerArrayMethodsInLoops": "error",
        "noErasingOperation": "error",
        "noExcessiveNestedBlocks": "error",
        "noImpliedEval": "error",
        "noInvalidFileInputAccept": "error",
        "noInvalidRemoveEventListener": "error",
        "noJsonUnsafeValues": "error",
        "noLateEventControl": "error",
        "noMagicArrayFlatDepth": "error",
        "noMapSpread": "error",
        "noMeaninglessVoidOperator": "error",
        "noMisleadingReturnType": "error",
        "noMismatchedMapKey": "error",
        "noMisplacedListElements": "error",
        "noMissingThrow": "error",
        "noNegatedArrayPredicate": "error",
        "noNegationInEqualityCheck": "error",
        "noNestedSwitch": "error",
        "noNestedTemplateLiterals": "error",
        "noNewRequire": "error",
        "noNumberArgumentOutOfRange": "error",
        "noObjectConstructor": "error",
        "noObjectLiteralComparison": "error",
        "noObsoleteAttributes": "error",
        "noOctal": "error",
        "noPathConcat": "error",
        "noPromiseExecutorReturn": "error",
        "noPseudoElementInFunctionalPseudoClass": "error",
        "noReturnArrayPush": "error",
        "noReturnInFinally": "error",
        "noSelfImport": "error",
        "noSharedBranchCode": "error",
        "noSinglePromiseInPromiseMethods": "error",
        "noSubtractionComparison": "error",
        "noThisOutsideOfClass": "error",
        "noUndeclaredClasses": "error",
        "noUninvokedArrayCallback": "error",
        "noUnmodifiedLoopCondition": "error",
        "noUnnecessaryStringTrim": "error",
        "noUnreadableForOfExpression": "error",
        "noUnreadableIife": "error",
        "noUnsafePlusOperands": "error",
        "noUnsafeReturn": "error",
        "noUnsafeTypeAssertion": "error",
        "noUnsafeUnaryMinus": "error",
        "noUselessAssignment": "error",
        "noUselessAwait": "error",
        "noUselessDateGetTime": "error",
        "noUselessLengthCheck": "error",
        "noUselessRecursion": "error",
        "noUselessSplice": "error",
        "noUselessTypeAssertion": "error",
        "noYamlBooleanKeys": "error",
        "noZeroFractions": "error",
        "noZeroLengthUnit": "error",
        "useAccessorPairs": "error",
        "useBlockStatementOverIife": "error",
        "useCapitalizedConstructors": "error",
        "useConsistentJsonFileRead": "error",
        "useConsistentLightnessNotation": "error",
        "useConsistentUnicodeBom": "error",
        "useExpectToContain": "error",
        "useExplicitType": "error",
        "useFlatMathMinMax": "error",
        "useIncludes": "error",
        "useIteratorZip": "error",
        "useLowercaseTestTitle": "error",
        "useMatchingFunctionName": "error",
        "useMathAbs": "error",
        "useMathTrunc": "error",
        "useModernMathApis": "error",
        "useNamedFunction": "error",
        "useNullishCoalescing": "error",
        "useObjectFromEntries": "error",
        "usePackageJsonValidCpu": "error",
        "usePackageJsonValidEngines": "error",
        "usePromiseRejectErrors": "error",
        "useReactCompiler": "error",
        "useSetSize": "error",
        "useSimplifiedBooleanReturn": "error",
        "useStringStartsEndsWith": "error",
        "useTailwindShorthandClasses": "error",
        "useTailwindVariablesShorthand": "error",
        "useValidTestTitle": "error",
        "useWhileLoopCondition": "error",
        "useConsistentFunctionStyle": {
          "level": "error",
          "options": {
            "allowArrowFunctions": true
          }
        }
      },
      "performance": {
        "noAwaitInLoops": "error",
        "noBarrelFile": "error",
        "noDelete": "off",
        "noJsxPropsBind": "off",
        "noNamespaceImport": "error",
        "noReExportAll": "error",
        "noSyncScripts": "error",
        "useDomNodeTextContent": "error",
        "useSolidForComponent": "off",
        "useTopLevelRegex": "error"
      },
      "security": {
        "noSecrets": "off",
        "useIframeSandbox": "error"
      },
      "style": {
        "noCommonJs": "error",
        "noDefaultExport": "off",
        "noExcessiveLinesPerFile": "off",
        "noExportedImports": "error",
        "noImplicitBoolean": "error",
        "noIncrementDecrement": "off",
        "noInferrableTypes": "off",
        "noJsxLiterals": "off",
        "noMagicNumbers": "error",
        "noMultilineString": "error",
        "noNamespace": "error",
        "noProcessEnv": "off",
        "noReactNativeLiteralColors": "off",
        "noTernary": "off",
        "noUnusedTemplateLiteral": "error",
        "useAsConstAssertion": "error",
        "useConsistentEnumValueType": "error",
        "useConsistentMethodSignatures": "error",
        "useDestructuring": "error",
        "useDomQuerySelector": "error",
        "useErrorCause": "off",
        "useFilenamingConvention": "off",
        "useGlobalThis": "error",
        "useImportsFirst": "error",
        "useNamingConvention": "off",
        "useNumericSeparators": "error",
        "useReduceTypeParameter": "error",
        "useSpreadOverApply": "error",
        "useTestHooksInOrder": "error",
        "useThisInClassMethods": "error",
        "useVarsOnTop": "error",
        "useConsistentTestIt": {
          "level": "error",
          "options": {
            "function": "test",
            "withinDescribe": "test"
          }
        },
        "useExportType": {
          "level": "error",
          "options": {
            "style": "inlineType"
          }
        },
        "useImportType": {
          "level": "error",
          "options": {
            "style": "inlineType"
          }
        }
      },
      "suspicious": {
        "noConditionalExpect": "error",
        "noDuplicatedSpreadProps": "error",
        "noEmptyBlockStatements": "error",
        "noEqualsToNull": "error",
        "noForIn": "error",
        "noGlobalIsNan": "error",
        "noIdenticalTestTitle": "error",
        "noJsxLeakedDollar": "error",
        "noLeakedRender": "error",
        "noLoopFunc": "error",
        "noNestedPromises": "error",
        "noReactSpecificProps": "off",
        "noReactStringRefs": "error",
        "noUnknownAttribute": "error",
        "noUnnecessaryConditions": "error",
        "useArraySortCompare": "error",
        "useExpect": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["dir", "error", "groupCollapsed", "groupEnd", "info", "table"]
          }
        }
      }
    }
  },
  "vcs": {
    "clientKind": "git",
    "defaultBranch": "main",
    "enabled": true
  }
}
